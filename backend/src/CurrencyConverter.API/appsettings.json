{
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Frankfurter": {
    "BaseUrl": "https://api.frankfurter.dev",
    "TimeoutSeconds": 10
  },
  "CurrencyProvider": {
    "DefaultProvider": "Frankfurter"
  },
  "CacheSettings": {
    "LatestRatesTtlMinutes": 30,
    "CurrenciesTtlMinutes": 60,
    "GapMergeThresholdDays": 5
  },
  "JwtSettings": {
    "Issuer": "CurrencyConverter",
    "Audience": "CurrencyConverterClient",
    "ExpirationMinutes": 60
  },
  "RateLimiting": {
    "RequestsPerMinute": 120
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName", "WithProcessId" ]
  },
  "AllowedHosts": "*"
}
